# --- Database ---
# Local/dev (default): SQLite. Production: a Postgres URL, e.g.
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./reach.db

# --- Channel service ---
CHANNEL_SERVICE_URL=http://localhost:8001
CRM_PUBLIC_URL=http://localhost:8000
WEBHOOK_SECRET=dev-shared-secret-change-me

# --- LLM (swappable provider) ---
# LLM_PROVIDER selects the backend: "gemini" or "groq". Set the matching key.
LLM_PROVIDER=gemini
# Google Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq free tier (Llama 3.3 70B) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS (comma-separated; set your Vercel URL in prod) ---
CORS_ORIGINS=*
